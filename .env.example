# Copia este fichero a .env y ajusta los valores.
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://anfitria:anfitria@db:5432/anfitria
REDIS_URL=redis://redis:6379/0

# --- IA ---
# mock  -> respuestas sin clave (la demo arranca siempre)
# anthropic -> Claude real. Para activarlo:
#   AI_PROVIDER=anthropic  y  ANTHROPIC_API_KEY=sk-ant-...
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Modelo. Por defecto claude-opus-5; para un conserje de alto volumen,
# claude-haiku-4-5 es más rápido y barato.
ANTHROPIC_MODEL=claude-opus-5

# --- Canal de mensajería ---
# sim -> WhatsApp simulado dentro de la app
# whatsapp_cloud -> Meta WhatsApp Cloud API (número de test o producción)
CHANNEL_PROVIDER=sim
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
