# Copia este fichero a .env y ajusta los valores.
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://anfitria:anfitria@db:5432/anfitria
REDIS_URL=redis://redis:6379/0

# --- IA ---
# mock  -> respuestas sin clave (la demo arranca siempre)
# anthropic -> Claude real (requiere ANTHROPIC_API_KEY)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Canal de mensajería ---
# sim -> WhatsApp simulado dentro de la app
# whatsapp_cloud -> Meta WhatsApp Cloud API (número de test o producción)
CHANNEL_PROVIDER=sim
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
